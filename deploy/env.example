# Tangerine Phuket — environment file template (Wave 1, Slice 6).
#
# The REAL file lives at /etc/tangerine/env on the server, mode 0600, owned by
# root. It is sourced by the systemd unit (EnvironmentFile=) and by the cron
# jobs. It holds every secret — keep it OFF the repo and OUT of the database.
#
#   sudo install -m 0600 -o root -g root deploy/env.example /etc/tangerine/env
#   sudo $EDITOR /etc/tangerine/env   # fill in the real values
#
# Format is KEY=value (no `export`, no spaces around `=`) so the same file is
# valid for both systemd's EnvironmentFile and shell `. ` sourcing in cron.

# --- Auth (slice 4) ---------------------------------------------------------
# Long random shared passphrase the two partners type at login.
TANGERINE_AUTH_PASSPHRASE=change-me-to-a-long-random-passphrase
# Cookie-signing secret, distinct from the passphrase so either can rotate
# independently. Generate with e.g. `openssl rand -hex 32`.
TANGERINE_SIGNING_SECRET=change-me-to-a-long-random-secret
# Mark session cookies Secure (served over HTTPS in production).
TANGERINE_COOKIE_SECURE=1

# --- Persistence (slice 1 / ADR-0001) ---------------------------------------
TANGERINE_DB_PATH=/var/lib/tangerine/tangerine.db

# --- Loyverse sync (slice 3, PRD user story 11) -----------------------------
LOYVERSE_ACCESS_TOKEN=your-loyverse-access-token
LOYVERSE_STORE_ID=your-loyverse-store-id
# Comma-separated Loyverse category UUIDs that tag menu items as the cafe
# segment (ADR-0009). Every other category defaults to bar (two segments, no
# third). Unset or blank = no cafe category configured = every item is tagged
# bar (the documented default). Find the real UUIDs by running:
#   python scripts/dump_loyverse_items.py > menu.tsv
# and reading the category_id column for the cafe items. The venue has one
# cafe category today; Loyverse sub-categories allow more than one.
LOYVERSE_CAFE_CATEGORY_IDS=
# Comma-separated payment-type → channel map for the IN-01 five-number
# derivation (issue #147): "<payment_type_id>:<channel>" pairs. Channels are
# cash / qr / card — the venue's till-QR tender is named "Transfer" in
# Loyverse and routes to qr. The ids are opaque account UUIDs, so they cannot
# ship in the repo. Find them by running:
#   python scripts/dump_payment_types.py
# and pasting each id with its channel, e.g.
#   LOYVERSE_PAYMENT_TYPE_CHANNELS=abc123...:cash,def456...:qr,789abc...:card
# Unset or blank = the derivation's facts path is skipped (sync stays green
# until the UUIDs are provided).
LOYVERSE_PAYMENT_TYPE_CHANNELS=

# --- Nightly snapshot tuning (used by deploy/tangerine-snapshot.sh) ----------
TANGERINE_SNAPSHOT_DIR=/var/lib/tangerine/snapshots
TANGERINE_SNAPSHOT_KEEP=14
